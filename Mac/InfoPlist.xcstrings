    "NSLocationUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reader verwendet deinen Standort, um auf dem Heute-Tab das lokale Wetter anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reader uses your location to show local weather on the Today tab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reader utilise votre position pour afficher la météo locale dans l’onglet Aujourd’hui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reader usa la tua posizione per mostrare il meteo locale nella scheda Oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リーダーは「Today」タブにローカルの天気を表示するために位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "리더는 Today 탭에 현지 날씨를 표시하기 위해 위치 정보를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reader gebruikt je locatie om het lokale weer op het tabblad Vandaag te tonen."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reader sử dụng vị trí của bạn để hiển thị thời tiết tại địa phương trong tab Today."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阅读器使用您的位置，在「Today」标签页中显示本地天气。"
          }
