    "Bluesky.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentliche Bluesky-Profile, benutzerdefinierte Feeds und Listen funktionieren ohne Anmeldung. Durch die Anmeldung werden deine „Gefolgt“-Timeline, personalisierte Feeds, der Import gespeicherter Feeds und deine Bluesky-Moderationseinstellungen freigeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public Bluesky profiles, custom feeds, and lists work without signing in. Sign in to unlock your Following timeline, personalized feeds, saved feed import, and your Bluesky moderation preferences."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils publics, flux personnalisés et listes Bluesky fonctionnent sans connexion. Connectez-vous pour accéder à votre fil Abonnements, aux flux personnalisés, à l’importation de vos flux enregistrés et à vos préférences de modération Bluesky."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili pubblici, i feed personalizzati e le liste di Bluesky funzionano senza accedere. Accedi per sbloccare la timeline Seguiti, i feed personalizzati, l’importazione dei feed salvati e le tue preferenze di moderazione di Bluesky."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開されているBlueskyプロフィール、カスタムフィード、リストはサインインなしで利用できます。サインインすると、フォロー中タイムライン、パーソナライズされたフィード、保存済みフィードのインポート、Blueskyのモデレーション設定が利用可能になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 Bluesky 프로필, 사용자 지정 피드 및 리스트는 로그인 없이 사용할 수 있습니다. 로그인하면 팔로잉 타임라인, 개인화 피드, 저장된 피드 가져오기 및 Bluesky 모더레이션 설정을 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Openbare Bluesky-profielen, aangepaste feeds en lijsten werken zonder in te loggen. Log in om je Volgend-tijdlijn, gepersonaliseerde feeds, het importeren van opgeslagen feeds en je Bluesky-moderatievoorkeuren te gebruiken."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ công khai, nguồn cấp tùy chỉnh và danh sách Bluesky hoạt động mà không cần đăng nhập. Đăng nhập để mở khóa dòng thời gian Đang theo dõi, nguồn cấp cá nhân hóa, nhập nguồn cấp đã lưu và tùy chọn kiểm duyệt Bluesky của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开的 Bluesky 个人主页、自定义订阅源和列表无需登录即可使用。登录后可解锁“关注”时间线、个性化订阅源、导入已保存订阅源以及你的 Bluesky 审核偏好设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公開的 Bluesky 個人檔案、自訂訂閱源與清單無需登入即可使用。登入後即可解鎖「關注」時間軸、個人化訂閱源、匯入已儲存訂閱源以及你的 Bluesky 審核偏好設定。"
          }
        }
      }
    },
