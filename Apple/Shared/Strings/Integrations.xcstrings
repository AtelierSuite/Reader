    "Bluesky.Error.AccountUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bluesky-Konto ist derzeit nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Bluesky account is currently unavailable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Bluesky est actuellement indisponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account Bluesky non è attualmente disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このBlueskyアカウントは現在利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Bluesky 계정은 현재 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit Bluesky-account is momenteel niet beschikbaar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản Bluesky này hiện không khả dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Bluesky 账号当前不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Bluesky 帳號目前無法使用。"
          }
        }
      }
    },
    "Bluesky.Error.InvalidCredentials": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiges Handle oder App-Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid handle or app password."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiant ou mot de passe d’application invalide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle o password per app non validi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルまたはアプリパスワードが正しくありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들 또는 앱 비밀번호가 올바르지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeldige handle of ongeldig app-wachtwoord."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên người dùng hoặc mật khẩu ứng dụng không hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户名或应用密码无效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳號或應用程式密碼無效。"
          }
        }
      }
    },
    "Bluesky.Error.Network": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zu Bluesky fehlgeschlagen. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach Bluesky. Please try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Bluesky. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere Bluesky. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Blueskyに接続できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluesky에 연결할 수 없습니다. 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan geen verbinding maken met Bluesky. Probeer het opnieuw."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối đến Bluesky. Vui lòng thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 Bluesky，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至 Bluesky，請重試。"
          }
        }
      }
    },
    "Bluesky.Error.TwoFactorRequired": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende statt deines Hauptpassworts ein Bluesky-App-Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a Bluesky app password instead of your main password."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un mot de passe d’application Bluesky au lieu de votre mot de passe principal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una password per app di Bluesky invece della tua password principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインパスワードではなく、Blueskyのアプリパスワードを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 비밀번호 대신 Bluesky 앱 비밀번호를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een Bluesky-app-wachtwoord in plaats van je hoofdwachtwoord."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dùng mật khẩu ứng dụng Bluesky thay vì mật khẩu chính của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 Bluesky 应用密码，而不是主密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 Bluesky 應用程式密碼，而非主密碼。"
          }
        }
      }
    },
