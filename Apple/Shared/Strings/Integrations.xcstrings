    "Substack.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich bei Substack an, um abonnierte Inhalte aus Ihren Substack-Feeds abzurufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
